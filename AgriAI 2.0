<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgriAI - Bạn đồng hành cùng nhà nông trên hành trình phát triển nông nghiệp bền vững</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        emerald: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b',
                        },
                        amber: {
                            50: '#fffbeb',
                            100: '#fef3c7',
                            500: '#f59e0b',
                            600: '#d97706',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Hiệu ứng tia quét AI trên ảnh */
        @keyframes scanline {
            0% { top: 0%; opacity: 0.85; }
            50% { top: 96%; opacity: 1; }
            100% { top: 0%; opacity: 0.85; }
        }
        .animate-scan {
            animation: scanline 2.2s infinite ease-in-out;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-slate-50 text-gray-800 font-sans antialiased selection:bg-emerald-200 selection:text-emerald-900">

    <!-- ================= KHUNG THÔNG BÁO (TOAST) ================= -->
    <div id="toast-container" class="fixed top-20 right-4 z-50 flex flex-col gap-2 max-w-md w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- ================= THANH ĐIỀU HƯỚNG (HEADER) ================= -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-gray-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16 sm:h-20">
                <!-- Logo -->
                <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('home')">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-emerald-600 to-teal-700 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-emerald-200">
                        <i class="fa-solid fa-seedling text-xl sm:text-2xl"></i>
                    </div>
                    <div>
                        <div class="flex items-center space-x-1.5">
                            <span class="text-xl sm:text-2xl font-extrabold bg-gradient-to-r from-emerald-800 to-teal-600 bg-clip-text text-transparent">AgriAI</span>
                            <span class="px-2 py-0.5 text-[10px] sm:text-xs font-bold bg-amber-100 text-amber-800 rounded-full border border-amber-200">NÔNG NGHIỆP SỐ</span>
                        </div>
                        <p class="text-[11px] sm:text-xs text-gray-500 font-medium hidden sm:block">Bạn đồng hành cùng nhà nông trên hành trình phát triển nông nghiệp bền vững</p>
                    </div>
                </div>

                <!-- Menu Máy tính -->
                <nav class="hidden lg:flex items-center space-x-1 bg-gray-100/80 p-1.5 rounded-2xl">
                    <button onclick="switchTab('home')" id="nav-home" class="nav-btn active px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 bg-white text-emerald-700 shadow-sm">
                        <i class="fa-solid fa-house mr-1.5"></i>Trang chủ
                    </button>
                    <button onclick="switchTab('ai-doctor')" id="nav-ai-doctor" class="nav-btn px-4 py-2 rounded-xl text-sm font-semibold text-gray-600 hover:text-emerald-700 transition-all duration-200">
                        <i class="fa-solid fa-camera-retro mr-1.5 text-emerald-600"></i>AI Chuẩn Đoán
                    </button>
                    <button onclick="switchTab('weather-calendar')" id="nav-weather-calendar" class="nav-btn px-4 py-2 rounded-xl text-sm font-semibold text-gray-600 hover:text-emerald-700 transition-all duration-200">
                        <i class="fa-solid fa-cloud-sun-rain mr-1.5"></i>Thời tiết & Lịch vụ
                    </button>
                    <button onclick="switchTab('market-pest')" id="nav-market-pest" class="nav-btn px-4 py-2 rounded-xl text-sm font-semibold text-gray-600 hover:text-emerald-700 transition-all duration-200">
                        <i class="fa-solid fa-chart-line mr-1.5"></i>Giá & Dịch hại
                    </button>
                    <button onclick="switchTab('community')" id="nav-community" class="nav-btn px-4 py-2 rounded-xl text-sm font-semibold text-gray-600 hover:text-emerald-700 transition-all duration-200">
                        <i class="fa-solid fa-comments mr-1.5"></i>Hỏi đáp kỹ sư
                    </button>
                </nav>

                <!-- Nút hành động nhanh & Menu Điện thoại -->
                <div class="flex items-center space-x-2">
                    <button onclick="switchTab('ai-doctor')" class="hidden sm:flex items-center space-x-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl font-semibold text-sm shadow-md shadow-emerald-200 transition-all active:scale-95">
                        <i class="fa-solid fa-magnifying-glass-chart"></i>
                        <span>Quét Bệnh Ngay</span>
                    </button>
                    <button onclick="toggleMobileMenu()" class="lg:hidden p-2.5 rounded-xl bg-gray-100 text-gray-700 hover:bg-gray-200" aria-label="Mở menu">
                        <i class="fa-solid fa-bars text-lg" id="mobile-menu-icon"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Menu Điện thoại -->
        <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100 px-4 pt-2 pb-4 space-y-1 shadow-lg">
            <button onclick="switchTab('home'); toggleMobileMenu()" class="w-full text-left px-4 py-3 rounded-xl text-sm font-semibold text-emerald-700 bg-emerald-50 flex items-center">
                <i class="fa-solid fa-house w-6"></i> Trang chủ tổng quan
            </button>
            <button onclick="switchTab('ai-doctor'); toggleMobileMenu()" class="w-full text-left px-4 py-3 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 flex items-center">
                <i class="fa-solid fa-camera-retro w-6 text-emerald-600"></i> AI Chuẩn Đoán Bệnh Cây
            </button>
            <button onclick="switchTab('weather-calendar'); toggleMobileMenu()" class="w-full text-left px-4 py-3 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 flex items-center">
                <i class="fa-solid fa-cloud-sun-rain w-6 text-blue-600"></i> Thời tiết & Lịch công tác
            </button>
            <button onclick="switchTab('market-pest'); toggleMobileMenu()" class="w-full text-left px-4 py-3 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 flex items-center">
                <i class="fa-solid fa-chart-line w-6 text-amber-600"></i> Giá nông sản & Cảnh báo dịch
            </button>
            <button onclick="switchTab('community'); toggleMobileMenu()" class="w-full text-left px-4 py-3 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 flex items-center">
                <i class="fa-solid fa-comments w-6 text-purple-600"></i> Hỏi đáp cùng Kỹ sư
            </button>
        </div>
    </header>

    <!-- ================= NỘI DUNG CHÍNH ================= -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 min-h-screen">

        <!-- ========================================================== -->
        <!-- TAB 1: TRANG CHỦ TỔNG QUAN                                 -->
        <!-- ========================================================== -->
        <section id="tab-home" class="tab-content space-y-10">
            <!-- Hero Banner -->
            <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-emerald-900 via-emerald-800 to-teal-900 text-white shadow-xl">
                <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:20px_20px]"></div>
                <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 p-6 sm:p-10 lg:p-12 items-center">
                    <div class="lg:col-span-7 space-y-5">
                        <div class="inline-flex items-center space-x-2 bg-emerald-700/60 border border-emerald-500/40 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-medium text-emerald-100">
                            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                            <span>Ứng dụng Trí tuệ nhân tạo hỗ trợ nông dân Thăng Bình</span>
                        </div>
                        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
                            AgriAI – Bạn đồng hành cùng nhà nông phát triển <span class="text-amber-300">nông nghiệp bền vững</span>
                        </h1>
                        <p class="text-emerald-100 text-sm sm:text-base lg:text-lg leading-relaxed max-w-2xl">
                            Giải pháp chuyển đổi số toàn diện cho bà con nông dân vùng đất Thăng Bình. Nhận diện nhanh sâu bệnh hại trên lúa, hồ tiêu, đậu phộng, cây ăn quả chỉ qua 1 bức ảnh chụp, kết hợp dự báo thời tiết và lịch thời vụ chính xác.
                        </p>
                        <div class="flex flex-wrap gap-3 pt-2">
                            <button onclick="switchTab('ai-doctor')" class="bg-amber-500 hover:bg-amber-600 text-gray-950 font-bold px-6 py-3.5 rounded-2xl shadow-lg shadow-amber-900/30 transition-all flex items-center space-x-2 active:scale-95">
                                <i class="fa-solid fa-camera text-lg"></i>
                                <span>Chẩn Đoán Bệnh Bằng AI</span>
                            </button>
                            <button onclick="switchTab('weather-calendar')" class="bg-white/15 hover:bg-white/25 text-white border border-white/25 font-semibold px-6 py-3.5 rounded-2xl backdrop-blur-sm transition-all flex items-center space-x-2">
                                <i class="fa-solid fa-calendar-days"></i>
                                <span>Xem Thời Tiết & Lịch Vụ</span>
                            </button>
                        </div>
                    </div>

                    <!-- Thẻ thông tin nhanh bên phải Hero -->
                    <div class="lg:col-span-5">
                        <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-6 space-y-5">
                            <div class="flex items-start justify-between border-b border-white/15 pb-4 gap-3">
                                <div>
                                    <p class="text-xs text-emerald-200 uppercase font-semibold tracking-wider">Khu vực trọng điểm</p>
                                    <h3 class="text-lg font-bold text-white">Thăng Bình, Đà Nẵng</h3>
                                    <p id="hero-current-date" class="text-xs text-amber-300 font-semibold mt-1">Đang cập nhật thứ, ngày...</p>
                                    <p id="hero-live-clock" class="text-xs text-emerald-100 font-mono mt-0.5 flex items-center">
                                        <i class="fa-regular fa-clock mr-1.5 text-amber-300"></i> --:--:--
                                    </p>
                                </div>
                                <div class="text-right">
                                    <span class="text-2xl sm:text-3xl font-extrabold text-amber-300" id="hero-weather-temp">29°C</span>
                                    <p class="text-xs text-emerald-100 mt-0.5" id="hero-weather-desc">Nắng nhẹ • Độ ẩm 82%</p>
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-3">
                                <div class="bg-emerald-950/50 p-3.5 rounded-2xl border border-emerald-700/40">
                                    <div class="text-amber-400 text-xl font-extrabold">Gemini AI</div>
                                    <div class="text-xs text-emerald-100 mt-0.5">Phân tích ảnh bệnh trực tiếp</div>
                                </div>
                                <div class="bg-emerald-950/50 p-3.5 rounded-2xl border border-emerald-700/40">
                                    <div class="text-emerald-300 text-xl font-extrabold">24+ Bệnh</div>
                                    <div class="text-xs text-emerald-100 mt-0.5">Lúa, Tiêu, Đậu phộng, Rau</div>
                                </div>
                            </div>

                            <div class="bg-amber-500/20 border border-amber-400/40 rounded-2xl p-3.5 flex items-start space-x-3">
                                <i class="fa-solid fa-triangle-exclamation text-amber-300 mt-1"></i>
                                <div class="text-xs text-amber-100 leading-relaxed">
                                    <strong class="text-white block">Cảnh báo dịch hại tuần này:</strong>
                                    Đang xuất hiện rầy nâu và bệnh đạo ôn lá rải rác trên trà lúa tại các xã Bình Nguyên, Bình Quý, Bình An.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4 Tính năng cốt lõi -->
            <div>
                <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6">
                    <div>
                        <span class="text-emerald-600 font-bold text-xs uppercase tracking-wider">Hệ sinh thái tính năng</span>
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mt-1">Công Cụ Hỗ Trợ Nhà Nông Toàn Diện</h2>
                    </div>
                    <p class="text-sm text-gray-500 mt-2 sm:mt-0">Chạm vào từng thẻ để truy cập nhanh chức năng</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    <!-- Tính năng 1 -->
                    <div onclick="switchTab('ai-doctor')" class="group bg-white rounded-3xl p-6 shadow-sm hover:shadow-xl border border-gray-100 hover:border-emerald-200 transition-all cursor-pointer flex flex-col justify-between">
                        <div>
                            <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-microscope"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 group-hover:text-emerald-700">AI Nhận Diện Bệnh</h3>
                            <p class="text-sm text-gray-600 mt-2 leading-relaxed">Tải ảnh hoặc chụp trực tiếp lá, thân, rễ cây bị bệnh. AI phân tích và đưa ra phác đồ điều trị sinh học & hóa học.</p>
                        </div>
                        <div class="mt-5 pt-4 border-t border-gray-100 flex items-center text-emerald-600 font-semibold text-sm">
                            <span>Bắt đầu quét ảnh</span>
                            <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- Tính năng 2 -->
                    <div onclick="switchTab('weather-calendar')" class="group bg-white rounded-3xl p-6 shadow-sm hover:shadow-xl border border-gray-100 hover:border-blue-200 transition-all cursor-pointer flex flex-col justify-between">
                        <div>
                            <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-cloud-sun"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 group-hover:text-blue-700">Thời Tiết & Lịch Vụ Mùa</h3>
                            <p class="text-sm text-gray-600 mt-2 leading-relaxed">Theo dõi thời tiết theo từng thứ, ngày trong tuần và lịch công tác xuống giống, bón phân chuẩn khuyến nông.</p>
                        </div>
                        <div class="mt-5 pt-4 border-t border-gray-100 flex items-center text-blue-600 font-semibold text-sm">
                            <span>Xem dự báo & lịch</span>
                            <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- Tính năng 3 -->
                    <div onclick="switchTab('market-pest')" class="group bg-white rounded-3xl p-6 shadow-sm hover:shadow-xl border border-gray-100 hover:border-amber-200 transition-all cursor-pointer flex flex-col justify-between">
                        <div>
                            <div class="w-14 h-14 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-sack-dollar"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 group-hover:text-amber-700">Giá Nông Sản & Dịch Hại</h3>
                            <p class="text-sm text-gray-600 mt-2 leading-relaxed">Cập nhật giá lúa tươi, đậu phộng, hồ tiêu, sắn, ném tại địa phương và cảnh báo ổ dịch mới nhất.</p>
                        </div>
                        <div class="mt-5 pt-4 border-t border-gray-100 flex items-center text-amber-600 font-semibold text-sm">
                            <span>Tra cứu thị trường</span>
                            <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- Tính năng 4 -->
                    <div onclick="switchTab('community')" class="group bg-white rounded-3xl p-6 shadow-sm hover:shadow-xl border border-gray-100 hover:border-purple-200 transition-all cursor-pointer flex flex-col justify-between">
                        <div>
                            <div class="w-14 h-14 bg-purple-100 text-purple-600 rounded-2xl flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-user-doctor"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 group-hover:text-purple-700">Tư Vấn Kỹ Sư AI</h3>
                            <p class="text-sm text-gray-600 mt-2 leading-relaxed">Đặt câu hỏi trực tuyến về kỹ thuật canh tác hữu cơ, cải tạo đất cát ven biển và nhận giải đáp tức thì từ AI.</p>
                        </div>
                        <div class="mt-5 pt-4 border-t border-gray-100 flex items-center text-purple-600 font-semibold text-sm">
                            <span>Gửi câu hỏi ngay</span>
                            <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Vùng chuyên canh -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 shadow-sm">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                    <div>
                        <h3 class="text-xl font-extrabold text-gray-900">Vùng Chuyên Canh Nông Nghiệp Bền Vững Thăng Bình</h3>
                        <p class="text-sm text-gray-600 mt-1">Tối ưu hóa canh tác theo đặc thù thổ nhưỡng vùng cát ven biển, vùng đồng bằng và vùng gò đồi bán sơn địa.</p>
                    </div>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 w-fit">
                        <i class="fa-solid fa-leaf mr-1.5"></i> Hướng tới VietGAP & Hữu cơ
                    </span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="p-5 rounded-2xl bg-slate-50 border border-gray-100 space-y-2">
                        <div class="flex items-center space-x-2 text-emerald-700 font-bold">
                            <i class="fa-solid fa-wheat-awn"></i>
                            <span>Vùng Lúa Thâm Canh</span>
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">Tập trung tại Bình Nguyên, Bình Quý, Bình Phục, Bình Trị. Áp dụng quy trình "1 phải 5 giảm", quản lý dịch hại tổng hợp IPM bằng AI.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-slate-50 border border-gray-100 space-y-2">
                        <div class="flex items-center space-x-2 text-amber-700 font-bold">
                            <i class="fa-solid fa-seedling"></i>
                            <span>Vùng Đất Cát Ven Biển</span>
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">Bình Minh, Bình Dương, Bình Hải, Bình Nam. Chuyên canh đậu phộng (lạc), củ ném (hành tăm), măng tây xanh và rau màu tưới tiết kiệm.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-slate-50 border border-gray-100 space-y-2">
                        <div class="flex items-center space-x-2 text-teal-700 font-bold">
                            <i class="fa-solid fa-tree"></i>
                            <span>Vùng Gò Đồi Bán Sơn Địa</span>
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">Bình Lãnh, Bình Phú, Bình Chánh, Bình Quế. Phát triển cây hồ tiêu, cây ăn quả có múi (bưởi da xanh, cam), keo lai và chăn nuôi an toàn sinh học.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================================== -->
        <!-- TAB 2: AI CHUẨN ĐOÁN BỆNH CÂY QUA HÌNH ẢNH                 -->
        <!-- ========================================================== -->
        <section id="tab-ai-doctor" class="tab-content hidden space-y-8">
            <div class="bg-gradient-to-r from-emerald-800 to-teal-800 rounded-3xl p-6 sm:p-8 text-white shadow-lg">
                <div class="max-w-3xl">
                    <span class="px-3 py-1 bg-white/20 rounded-full text-xs font-bold uppercase tracking-wider">Công nghệ Thị giác máy tính & Gemini AI</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold mt-3">Bác Sĩ Cây Trồng AI – Nhận Diện Bệnh Qua Ảnh</h2>
                    <p class="text-emerald-100 text-sm sm:text-base mt-2">
                        Chụp rõ nét vùng lá, thân, quả hoặc rễ cây có dấu hiệu bất thường. Hệ thống Gemini AI sẽ phân tích hình ảnh thật, xác định tác nhân gây bệnh và đề xuất phác đồ xử lý an toàn.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- Cột trái: Tải ảnh & Mẫu bệnh -->
                <div class="lg:col-span-5 space-y-6">
                    <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200 space-y-5">
                        <div class="flex items-center justify-between gap-2">
                            <h3 class="text-lg font-bold text-gray-900 flex items-center">
                                <i class="fa-solid fa-cloud-arrow-up text-emerald-600 mr-2"></i>
                                1. Tải ảnh cây trồng cần kiểm tra
                            </h3>
                            <button type="button" onclick="testGeminiConnection()" class="px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-bold transition-all shrink-0">
                                <i class="fa-solid fa-plug-circle-check mr-1"></i> Kiểm tra AI
                            </button>
                        </div>

                        <!-- Chọn nhóm cây -->
                        <div>
                            <label class="block text-xs font-bold text-gray-600 uppercase mb-1.5">Chọn nhóm cây trồng (Tùy chọn)</label>
                            <select id="crop-type-select" class="w-full rounded-xl border-gray-300 bg-gray-50 border px-3.5 py-2.5 text-sm font-medium focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none">
                                <option value="auto">Tự động nhận diện cây trồng</option>
                                <option value="Lúa nước">Cây Lúa nước (Đông Xuân / Hè Thu)</option>
                                <option value="Đậu phộng (Lạc)">Cây Đậu phộng (Lạc)</option>
                                <option value="Hồ tiêu">Cây Hồ tiêu</option>
                                <option value="Cây ăn quả (Bưởi, Cam, Xoài)">Cây ăn quả (Bưởi, Cam, Chuối...)</option>
                                <option value="Rau màu & Củ ném">Rau màu & Củ ném</option>
                            </select>
                        </div>

                        <!-- Vùng tải ảnh / Xem trước -->
                        <div id="dropzone" onclick="document.getElementById('file-input').click()" class="relative border-2 border-dashed border-emerald-300 hover:border-emerald-500 bg-emerald-50/40 rounded-2xl p-6 text-center cursor-pointer transition-all min-h-[260px] flex flex-col items-center justify-center overflow-hidden group">
                            <input type="file" id="file-input" accept="image/*" class="hidden" onchange="handleImageUpload(event)">
                            
                            <!-- Trạng thái chưa chọn ảnh -->
                            <div id="upload-placeholder" class="space-y-3">
                                <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center mx-auto text-2xl group-hover:scale-110 transition-transform">
                                    <i class="fa-solid fa-camera"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-gray-800">Nhấn để chọn ảnh hoặc chụp trực tiếp</p>
                                    <p class="text-xs text-gray-500 mt-1">Hỗ trợ định dạng JPG, PNG, WEBP (Tự động tối ưu tốc độ quét)</p>
                                </div>
                            </div>

                            <!-- Ảnh xem trước -->
                            <img id="image-preview" src="" alt="Ảnh cây trồng" class="hidden max-h-64 w-auto rounded-xl object-contain shadow-md">
                            
                            <!-- Hiệu ứng đang quét AI -->
                            <div id="scan-overlay" class="hidden absolute inset-0 bg-emerald-950/70 backdrop-blur-[2px] flex flex-col items-center justify-center text-white px-4">
                                <div class="w-full h-1 bg-emerald-400 shadow-[0_0_15px_#34d399] absolute animate-scan"></div>
                                <i class="fa-solid fa-microchip text-3xl text-emerald-300 animate-pulse mb-2"></i>
                                <p class="text-sm font-bold tracking-wide">GEMINI AI ĐANG QUÉT BỆNH TRÊN ẢNH...</p>
                                <p id="scan-status-sub" class="text-xs text-emerald-200 mt-1">Đang gửi dữ liệu tới máy chủ Google AI...</p>
                            </div>
                        </div>

                        <!-- Nút bấm -->
                        <div class="flex gap-3">
                            <button id="analyze-btn" onclick="runAIDiagnosis()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 disabled:opacity-60 disabled:cursor-not-allowed text-white font-bold py-3.5 px-5 rounded-xl shadow-md shadow-emerald-200 transition-all flex items-center justify-center space-x-2 active:scale-95">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                                <span>Phân Tích Bệnh Bằng AI</span>
                            </button>
                            <button onclick="resetDiagnosis()" class="px-4 py-3.5 rounded-xl border border-gray-200 hover:bg-gray-100 text-gray-600 font-semibold text-sm transition-all" title="Làm mới">
                                <i class="fa-solid fa-rotate-left"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Thư viện 8 mẫu bệnh phổ biến -->
                    <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200 space-y-4">
                        <div class="flex items-center justify-between">
                            <h4 class="text-sm font-bold text-gray-900">
                                <i class="fa-solid fa-vial text-amber-500 mr-1.5"></i> Tra cứu nhanh phác đồ 8 bệnh phổ biến:
                            </h4>
                            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full">Cẩm nang</span>
                        </div>
                        <div id="sample-buttons-grid" class="grid grid-cols-2 gap-2.5">
                            <!-- Tạo tự động bằng JS -->
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Kết quả chẩn đoán -->
                <div class="lg:col-span-7">
                    <!-- Trạng thái trống -->
                    <div id="result-empty" class="bg-white rounded-3xl p-8 sm:p-12 shadow-sm border border-gray-200 h-full flex flex-col items-center justify-center text-center space-y-4 min-h-[450px]">
                        <div class="w-20 h-20 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center text-3xl">
                            <i class="fa-solid fa-file-medical"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-800">Chưa có dữ liệu chẩn đoán</h3>
                        <p class="text-sm text-gray-500 max-w-md leading-relaxed">
                            Vui lòng tải lên hình ảnh lá cây bị bệnh bên cột trái rồi bấm <strong>Phân Tích Bệnh Bằng AI</strong>, hoặc chọn một trong <strong>8 bệnh phổ biến</strong> để xem phác đồ phòng trừ.
                        </p>
                        <div class="grid grid-cols-3 gap-3 pt-4 w-full max-w-md text-left">
                            <div class="p-3 rounded-2xl bg-emerald-50/70 border border-emerald-100">
                                <div class="text-emerald-700 font-bold text-xs">Bước 1</div>
                                <div class="text-[11px] text-gray-600 mt-0.5">Chụp cận cảnh vết bệnh</div>
                            </div>
                            <div class="p-3 rounded-2xl bg-emerald-50/70 border border-emerald-100">
                                <div class="text-emerald-700 font-bold text-xs">Bước 2</div>
                                <div class="text-[11px] text-gray-600 mt-0.5">Bấm Phân tích AI</div>
                            </div>
                            <div class="p-3 rounded-2xl bg-emerald-50/70 border border-emerald-100">
                                <div class="text-emerald-700 font-bold text-xs">Bước 3</div>
                                <div class="text-[11px] text-gray-600 mt-0.5">Nhận phác đồ điều trị</div>
                            </div>
                        </div>
                    </div>

                    <!-- Thẻ kết quả chẩn đoán -->
                    <div id="result-card" class="hidden bg-white rounded-3xl shadow-md border border-emerald-200 overflow-hidden space-y-0">
                        <div class="bg-gradient-to-r from-emerald-700 to-teal-700 p-6 text-white">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <span id="res-crop-badge" class="px-3 py-1 bg-white/20 rounded-full text-xs font-bold">Cây Lúa nước</span>
                                <span id="res-confidence" class="px-3 py-1 bg-amber-400 text-gray-950 rounded-full text-xs font-extrabold">Độ tin cậy AI: 96.4%</span>
                            </div>
                            <h3 id="res-disease-name" class="text-2xl sm:text-3xl font-extrabold mt-3">Bệnh Đạo Ôn Lá</h3>
                            <div class="flex items-center space-x-4 mt-2 text-xs sm:text-sm text-emerald-100">
                                <span><i class="fa-solid fa-gauge-high mr-1"></i> Mức độ nguy hại: <strong id="res-severity" class="text-amber-300">Cao</strong></span>
                            </div>
                        </div>

                        <div class="p-6 sm:p-8 space-y-6">
                            <!-- Triệu chứng & Nguyên nhân -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="p-4 rounded-2xl bg-slate-50 border border-gray-100 space-y-1.5">
                                    <h4 class="text-xs font-extrabold uppercase text-gray-500 flex items-center">
                                        <i class="fa-solid fa-eye text-emerald-600 mr-1.5"></i> Triệu chứng nhận diện
                                    </h4>
                                    <p id="res-symptoms" class="text-sm text-gray-700 leading-relaxed"></p>
                                </div>
                                <div class="p-4 rounded-2xl bg-slate-50 border border-gray-100 space-y-1.5">
                                    <h4 class="text-xs font-extrabold uppercase text-gray-500 flex items-center">
                                        <i class="fa-solid fa-virus text-rose-500 mr-1.5"></i> Nguyên nhân & Điều kiện phát sinh
                                    </h4>
                                    <p id="res-cause" class="text-sm text-gray-700 leading-relaxed"></p>
                                </div>
                            </div>

                            <!-- Biện pháp sinh học -->
                            <div class="p-5 rounded-2xl bg-emerald-50/80 border border-emerald-200 space-y-2">
                                <h4 class="text-sm font-extrabold text-emerald-900 flex items-center">
                                    <i class="fa-solid fa-leaf text-emerald-600 mr-2 text-lg"></i>
                                    1. Biện pháp canh tác & Sinh học bền vững (Ưu tiên)
                                </h4>
                                <ul id="res-bio-steps" class="text-sm text-emerald-950 space-y-1.5 list-disc list-inside leading-relaxed"></ul>
                            </div>

                            <!-- Biện pháp hóa học -->
                            <div class="p-5 rounded-2xl bg-amber-50/80 border border-amber-200 space-y-2">
                                <h4 class="text-sm font-extrabold text-amber-900 flex items-center">
                                    <i class="fa-solid fa-flask-vial text-amber-600 mr-2 text-lg"></i>
                                    2. Biện pháp hóa học đặc trị (Áp dụng nguyên tắc "4 Đúng")
                                </h4>
                                <p id="res-chem-steps" class="text-sm text-amber-950 leading-relaxed"></p>
                            </div>

                            <!-- Ghi chú chuyên sâu từ Gemini AI -->
                            <div id="res-gemini-extra" class="hidden p-5 rounded-2xl bg-blue-50 border border-blue-200 space-y-2">
                                <h4 class="text-sm font-extrabold text-blue-900 flex items-center">
                                    <i class="fa-solid fa-robot text-blue-600 mr-2"></i> Phân tích chuyên sâu từ Trợ lý Gemini AI
                                </h4>
                                <div id="res-gemini-text" class="text-sm text-blue-950 whitespace-pre-line leading-relaxed"></div>
                            </div>

                            <!-- Chân thẻ kết quả -->
                            <div class="pt-4 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
                                <span class="text-xs text-gray-500"><i class="fa-solid fa-circle-info mr-1"></i> Khuyến cáo theo quy chuẩn Trạm Khuyến Nông</span>
                                <button onclick="copyDiagnosisReport()" class="px-4 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold transition-all flex items-center space-x-1.5">
                                    <i class="fa-solid fa-copy"></i>
                                    <span>Sao chép phác đồ điều trị</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================================== -->
        <!-- TAB 3: THỜI TIẾT NÔNG VỤ & LỊCH CÔNG TÁC                   -->
        <!-- ========================================================== -->
        <section id="tab-weather-calendar" class="tab-content hidden space-y-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- Thẻ Thời tiết (5 cột) -->
                <div class="lg:col-span-5 space-y-6">
                    <div class="bg-gradient-to-br from-blue-600 via-blue-700 to-indigo-800 rounded-3xl p-6 sm:p-8 text-white shadow-lg space-y-6 relative overflow-hidden">
                        <div class="flex items-start justify-between relative z-10 gap-2">
                            <div>
                                <span class="text-xs font-bold uppercase tracking-wider text-blue-200">Khí tượng nông nghiệp</span>
                                <h3 class="text-2xl font-extrabold mt-0.5">Thăng Bình, Đà Nẵng</h3>
                                <p id="weather-today-full-date" class="text-xs sm:text-sm font-semibold text-amber-300 mt-1 flex items-center">
                                    <i class="fa-regular fa-calendar mr-1.5"></i> Đang tải thứ, ngày...
                                </p>
                                <p id="weather-live-clock" class="text-xs font-mono text-blue-100 mt-1 flex items-center">
                                    <i class="fa-regular fa-clock mr-1.5 text-amber-300"></i> Đang đồng bộ giờ thực tế...
                                </p>
                            </div>
                            <button onclick="fetchLiveWeather(true)" class="bg-white/20 hover:bg-white/30 px-3 py-1.5 rounded-full text-xs font-bold backdrop-blur-md transition-all flex items-center space-x-1.5 shrink-0" title="Làm mới dữ liệu thời tiết">
                                <i id="weather-refresh-icon" class="fa-solid fa-rotate-right"></i>
                                <span id="weather-badge-time">Cập nhật</span>
                            </button>
                        </div>

                        <div class="flex items-center justify-between relative z-10">
                            <div>
                                <div id="weather-temp" class="text-5xl sm:text-6xl font-black">29°C</div>
                                <p id="weather-condition-text" class="text-blue-100 text-sm mt-1">Có mây, nắng nhẹ</p>
                            </div>
                            <div class="text-right space-y-1.5 text-xs sm:text-sm text-blue-100">
                                <div><i class="fa-solid fa-droplet w-5 text-cyan-300"></i> Độ ẩm: <strong id="weather-humidity" class="text-white">82%</strong></div>
                                <div><i class="fa-solid fa-wind w-5 text-cyan-300"></i> Gió: <strong id="weather-wind" class="text-white">12 km/h</strong></div>
                                <div><i class="fa-solid fa-cloud-rain w-5 text-cyan-300"></i> Xác suất mưa: <strong id="weather-rain" class="text-white">15%</strong></div>
                            </div>
                        </div>

                        <!-- Khuyến cáo canh tác theo thời tiết -->
                        <div class="bg-white/15 backdrop-blur-md rounded-2xl p-4 border border-white/20 space-y-1.5 relative z-10">
                            <div class="text-xs font-bold text-amber-300 uppercase flex items-center">
                                <i class="fa-solid fa-bullhorn mr-1.5"></i> Khuyến cáo canh tác tự động
                            </div>
                            <p id="weather-advice" class="text-xs sm:text-sm text-white leading-relaxed">
                                Độ ẩm sáng sớm cao (82%) thuận lợi cho nấm đạo ôn lá lúa và sương mai phát triển. Bà con nên thăm đồng kiểm tra và hạn chế bón thừa đạm.
                            </p>
                        </div>
                    </div>

                    <!-- Dự báo 5 ngày tới (Hiển thị đầy đủ Thứ, Ngày/Tháng) -->
                    <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200 space-y-4">
                        <div class="flex items-center justify-between">
                            <h4 class="text-base font-bold text-gray-900 flex items-center">
                                <i class="fa-solid fa-calendar-week text-blue-600 mr-2"></i> Dự báo thời tiết 5 ngày tới
                            </h4>
                            <span class="text-[11px] font-semibold text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded-full">Thứ & Ngày</span>
                        </div>
                        <div id="weather-forecast-list" class="space-y-2.5">
                            <!-- Tự động điền đủ Thứ + Ngày/Tháng bằng JavaScript -->
                        </div>
                    </div>
                </div>

                <!-- Lịch Công Tác & Quản lý công việc (7 cột) -->
                <div class="lg:col-span-7 space-y-6">
                    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-gray-200 space-y-6">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div>
                                <span class="text-xs font-bold uppercase text-emerald-600 tracking-wider">Khuyến nông địa phương</span>
                                <h3 class="text-2xl font-extrabold text-gray-900 mt-0.5">Lịch Công Tác & Thời Vụ</h3>
                            </div>
                            <button onclick="openAddTaskModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-sm transition-all flex items-center space-x-1.5 w-fit">
                                <i class="fa-solid fa-plus"></i>
                                <span>Thêm ghi chú công việc</span>
                            </button>
                        </div>

                        <!-- Bộ lọc nhóm cây -->
                        <div class="flex space-x-2 overflow-x-auto no-scrollbar pb-1">
                            <button onclick="filterTasks('all', this)" class="task-filter active px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 text-white">Tất cả công việc</button>
                            <button onclick="filterTasks('lua', this)" class="task-filter px-4 py-2 rounded-xl text-xs font-bold bg-gray-100 text-gray-600 hover:bg-gray-200">Cây Lúa</button>
                            <button onclick="filterTasks('hoamau', this)" class="task-filter px-4 py-2 rounded-xl text-xs font-bold bg-gray-100 text-gray-600 hover:bg-gray-200">Đậu phộng & Hoa màu</button>
                            <button onclick="filterTasks('cayanqua', this)" class="task-filter px-4 py-2 rounded-xl text-xs font-bold bg-gray-100 text-gray-600 hover:bg-gray-200">Hồ tiêu & Cây ăn quả</button>
                        </div>

                        <!-- Danh sách công việc -->
                        <div id="task-list" class="space-y-3.5">
                            <div class="task-item p-4 rounded-2xl border border-emerald-100 bg-emerald-50/40 flex items-start justify-between gap-4" data-category="lua">
                                <div class="flex items-start space-x-3.5">
                                    <input type="checkbox" checked onchange="toggleTaskComplete(this)" class="mt-1 w-5 h-5 rounded text-emerald-600 focus:ring-emerald-500 cursor-pointer">
                                    <div>
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Giai đoạn Đẻ nhánh - Làm đòng</span>
                                        <h4 class="text-sm font-bold text-gray-900 mt-1 line-through opacity-60">Bón thúc đợt 2 & điều tiết nước nông lộ phơi trên ruộng lúa</h4>
                                        <p class="text-xs text-gray-600 mt-1">Áp dụng cho giống lúa BC15, Thiên Ưu 8, Hà Phát 3. Giữ mực nước 3-5cm giúp rễ ăn sâu, hạn chế đổ ngã.</p>
                                    </div>
                                </div>
                                <span class="text-xs font-bold text-emerald-700 whitespace-nowrap">Tuần này</span>
                            </div>

                            <div class="task-item p-4 rounded-2xl border border-gray-200 bg-white flex items-start justify-between gap-4" data-category="hoamau">
                                <div class="flex items-start space-x-3.5">
                                    <input type="checkbox" onchange="toggleTaskComplete(this)" class="mt-1 w-5 h-5 rounded text-emerald-600 focus:ring-emerald-500 cursor-pointer">
                                    <div>
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">Vùng đất cát ven biển</span>
                                        <h4 class="text-sm font-bold text-gray-900 mt-1">Xới xáo phá váng, vun gốc và bón vôi bột cho cây Đậu phộng (Lạc)</h4>
                                        <p class="text-xs text-gray-600 mt-1">Bổ sung Canxi giúp chắc hạt, phòng ngừa bệnh héo xanh vi khuẩn và thối gốc mốc đen.</p>
                                    </div>
                                </div>
                                <span class="text-xs font-bold text-amber-600 whitespace-nowrap">Sắp tới</span>
                            </div>

                            <div class="task-item p-4 rounded-2xl border border-gray-200 bg-white flex items-start justify-between gap-4" data-category="cayanqua">
                                <div class="flex items-start space-x-3.5">
                                    <input type="checkbox" onchange="toggleTaskComplete(this)" class="mt-1 w-5 h-5 rounded text-emerald-600 focus:ring-emerald-500 cursor-pointer">
                                    <div>
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-teal-100 text-teal-800">Vùng gò đồi</span>
                                        <h4 class="text-sm font-bold text-gray-900 mt-1">Tỉa cành tạo tán & ủ phân hữu cơ vi sinh Trichoderma cho Hồ tiêu</h4>
                                        <p class="text-xs text-gray-600 mt-1">Tăng cường hệ vi sinh vật có ích quanh vùng rễ, ngăn ngừa tuyến trùng và nấm Phytophthora gây chết nhanh.</p>
                                    </div>
                                </div>
                                <span class="text-xs font-bold text-teal-600 whitespace-nowrap">Định kỳ</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================================== -->
        <!-- TAB 4: GIÁ NÔNG SẢN & CẢNH BÁO DỊCH HẠI                    -->
        <!-- ========================================================== -->
        <section id="tab-market-pest" class="tab-content hidden space-y-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- Bảng giá nông sản (7 cột) -->
                <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-gray-200 space-y-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div>
                            <span class="text-xs font-bold uppercase text-amber-600 tracking-wider">Thị trường nông sản</span>
