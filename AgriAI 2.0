        let selectedFileBase64 = null;
        let currentDiagnosisReport = '';

        function renderSampleButtons() {
            const container = document.getElementById('sample-buttons-grid');
            if (!container) return;
            container.innerHTML = DISEASE_DATABASE.map((item, idx) => `
                <button onclick="selectSampleDisease(${idx})" class="text-left p-2.5 rounded-xl border border-gray-200 hover:border-emerald-400 hover:bg-emerald-50/70 transition-all flex items-center space-x-2 group">
                    <span class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-700 text-xs font-bold flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-colors shrink-0">${idx + 1}</span>
                    <span class="text-xs font-semibold text-gray-700 group-hover:text-emerald-900 truncate">${item.shortName}</span>
                </button>
            `).join('');
        }

        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const maxDim = 360; // Tối ưu kích thước siêu nhẹ để gửi lên AI chỉ trong 1 giây
                    let w = img.width;
                    let h = img.height;
                    if (w > maxDim || h > maxDim) {
                        if (w > h) { h = Math.round((h * maxDim) / w); w = maxDim; }
                        else { w = Math.round((w * maxDim) / h); h = maxDim; }
                    }
                    canvas.width = w;
                    canvas.height = h;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, w, h);
                    
                    selectedFileBase64 = canvas.toDataURL('image/jpeg', 0.65);

                    const preview = document.getElementById('image-preview');
                    const placeholder = document.getElementById('upload-placeholder');
                    preview.src = selectedFileBase64;
                    preview.classList.remove('hidden');
                    placeholder.classList.add('hidden');
                    showToast('Đã tải ảnh lên! Nhấn "Phân Tích Bệnh Bằng AI" để quét.', 'info');
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function selectSampleDisease(index) {
            const sample = DISEASE_DATABASE[index];
            if (!sample) return;
            selectedFileBase64 = null;
            const preview = document.getElementById('image-preview');
            const placeholder = document.getElementById('upload-placeholder');
            preview.src = '';
            preview.classList.add('hidden');
            placeholder.classList.remove('hidden');
            displayDiagnosisResult(sample);
            showToast(`Đang hiển thị phác đồ chuẩn: ${sample.shortName}`, 'success');
        }

        function resetDiagnosis() {
            selectedFileBase64 = null;
            document.getElementById('file-input').value = '';
            document.getElementById('image-preview').src = '';
            document.getElementById('image-preview').classList.add('hidden');
            document.getElementById('upload-placeholder').classList.remove('hidden');
            document.getElementById('result-card').classList.add('hidden');
            document.getElementById('result-empty').classList.remove('hidden');
            showToast('Đã làm mới khu vực chẩn đoán.', 'info');
        }

        function displayDiagnosisResult(data, geminiExtraText = '') {
            document.getElementById('result-empty').classList.add('hidden');
            document.getElementById('result-card').classList.remove('hidden');

            document.getElementById('res-crop-badge').textContent = data.crop || 'Cây trồng';
            document.getElementById('res-confidence').textContent = `Độ tin cậy AI: ${data.confidence || '95%'}`;
            document.getElementById('res-disease-name').textContent = data.name || 'Chưa xác định rõ';
            document.getElementById('res-severity').textContent = data.severity || 'Cần theo dõi';
            document.getElementById('res-symptoms').textContent = data.symptoms || 'Đang cập nhật mô tả triệu chứng.';
            document.getElementById('res-cause').textContent = data.cause || 'Đang cập nhật nguyên nhân.';

            const bioList = document.getElementById('res-bio-steps');
            const steps = Array.isArray(data.bioSteps) && data.bioSteps.length > 0
                ? data.bioSteps
                : ['Vệ sinh đồng ruộng, tỉa bỏ lá bệnh nặng và giữ thông thoáng vườn cây.'];
            bioList.innerHTML = steps.map(step => `<li>${step}</li>`).join('');
            document.getElementById('res-chem-steps').textContent = data.chemSteps || 'Tham khảo cán bộ khuyến nông địa phương để chọn thuốc đặc trị phù hợp.';

            const extraBox = document.getElementById('res-gemini-extra');
            const extraText = document.getElementById('res-gemini-text');
            if (geminiExtraText && geminiExtraText.trim()) {
                extraText.textContent = geminiExtraText.trim();
                extraBox.classList.remove('hidden');
            } else {
                extraText.textContent = '';
                extraBox.classList.add('hidden');
            }

            currentDiagnosisReport = `BÁO CÁO CHẨN ĐOÁN AGRIAI\n- Cây trồng: ${data.crop}\n- Chẩn đoán: ${data.name} (${data.confidence})\n- Mức độ: ${data.severity}\n- Triệu chứng: ${data.symptoms}\n- Nguyên nhân: ${data.cause}\n- Biện pháp sinh học:\n  + ${steps.join('\n  + ')}\n- Biện pháp hóa học: ${data.chemSteps}${geminiExtraText ? `\n- Phân tích thêm từ AI: ${geminiExtraText.trim()}` : ''}`;
        }

        // Hàm gọi Gemini AI siêu tốc, ổn định, xử lý lỗi rõ ràng
        async function callGeminiWithFallback(payload, isJson = false) {
            const cleanKey = (GEMINI_API_KEY || '').trim();
            if (!cleanKey) {
                throw new Error('Chưa nhập mã GEMINI_API_KEY trong file code HTML!');
            }

            const fastModels = ['gemini-2.5-flash-lite', 'gemini-flash-latest', 'gemini-2.0-flash'];
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 25000);

                    currentDiagnosisReport = `BÁO CÁO CHẨN ĐOÁN AGRIAI\n- Cây trồng: ${data.crop}\n- Chẩn đoán: ${data.name} (${data.confidence})\n- Mức độ: ${data.severity}\n- Triệu chứng: ${data.symptoms}\n- Nguyên nhân: ${data.cause}\n- Biện pháp sinh học:\n  + ${steps.join('\n  + ')}\n- Biện pháp hóa học: ${data.chemSteps}${geminiExtraText ? `\n- Phân tích thêm từ AI: ${geminiExtraText.trim()}` : ''}`;
        }

        // Hàm kiểm tra nhanh kết nối API Key (chỉ gửi chữ nên phản hồi trong 1-2 giây)
        async function testGeminiConnection() {
            const cleanKey = getActiveApiKey();
            if (!cleanKey) {
                showToast('Chưa cấu hình GEMINI_API_KEY trong mã nguồn!', 'warning');
                return;
            }
            const t0 = Date.now();
            showToast('Đang kiểm tra kết nối tới Google AI...', 'info');
            try {
                await callGeminiWithFallback([{ text: 'Trả lời 1 chữ: OK' }]);
                const sec = ((Date.now() - t0) / 1000).toFixed(1);
                showToast(`Kết nối thành công! AI phản hồi sau ${sec}s`, 'success');
            } catch (err) {
                showToast(`Lỗi kết nối AI: ${err.message}`, 'error');
            }
        }

        // Hàm gọi Gemini AI siêu tốc (ưu tiên model nhẹ, tự động chuyển model nếu Google quá tải 503)
        async function callGeminiWithFallback(partsArray) {
            const cleanKey = getActiveApiKey();
            if (!cleanKey) {
                throw new Error('Chưa cấu hình mã GEMINI_API_KEY trong mã nguồn!');
            }

            const modelsToTry = [
                { name: 'gemini-2.5-flash-lite', noThinking: true },
                { name: 'gemini-2.5-flash', noThinking: true },
                { name: 'gemini-2.0-flash', noThinking: false },
                { name: 'gemini-2.0-flash-lite', noThinking: false },
                { name: 'gemini-flash-latest', noThinking: true }
            ];

            let lastError = null;
            const statusSub = document.getElementById('scan-status-sub');

            for (const m of modelsToTry) {
                if (statusSub) {
                    statusSub.textContent = `Đang xử lý bằng mô hình ${m.name}...`;
                }

                const url = `https://generativelanguage.googleapis.com/v1beta/models/${m.name}:generateContent`;
                const bodyObj = {
                    contents: [{ parts: partsArray }]
                };

                // Tắt bước suy nghĩ ngầm giúp mô hình 2.5 trả kết quả nhanh gấp 5 lần
                if (m.noThinking) {
                    bodyObj.generationConfig = {
                        thinkingConfig: { thinkingBudget: 0 }
                    };
                }

                // Thử tối đa 2 lần nếu máy chủ báo quá tải tạm thời (503 / high demand)
                for (let attempt = 1; attempt <= 2; attempt++) {
                    try {
                        const response = await fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'x-goog-api-key': cleanKey
                            },
                            body: JSON.stringify(bodyObj)
                        });

                        const data = await response.json();

                        if (!response.ok) {
                            const msg = data?.error?.message || `HTTP ${response.status}`;
                            lastError = new Error(msg);
                            // Nếu sai khóa API thì dừng ngay không cần thử model khác
                            if (response.status === 401 || response.status === 403 || msg.includes('API key not valid')) {
                                throw lastError;
                            }
                            // Nếu quá tải 503 hoặc 429 thì đợi 800ms rồi thử lại hoặc chuyển model kế tiếp
                            if ((response.status === 503 || response.status === 429 || msg.toLowerCase().includes('high demand')) && attempt === 1) {
                                await new Promise(r => setTimeout(r, 800));
                                continue;
                            }
                            break;
                        }

                        const parts = data.candidates?.[0]?.content?.parts || [];
                        const text = parts.map(p => p.text || '').join('\n').trim();
                        if (!text) {
                            lastError = new Error('Máy chủ AI không trả về nội dung.');
                            break;
                        }
                        return text;
                    } catch (err) {
                        lastError = err;
                        if (err.message && (err.message.includes('API key not valid') || err.message.includes('403') || err.message.includes('401'))) {
                            throw err;
                        }
                        break;
                    }
                }
            }

            throw lastError || new Error('Máy chủ Google AI đang bận, vui lòng thử lại sau vài giây.');
        }

        // Hàm chính thực hiện quét bệnh từ ảnh tải lên
        async function runAIDiagnosis() {
            if (!selectedFileBase64) {
                showToast('Vui lòng tải lên hình ảnh cây trồng trước khi bấm Phân Tích Bệnh!', 'warning');
                return;
            }

            if (!getActiveApiKey()) {
                showToast('Lỗi: Chưa cấu hình GEMINI_API_KEY trong mã nguồn!', 'error');
                return;
            }

            const overlay = document.getElementById('scan-overlay');
            const analyzeBtn = document.getElementById('analyze-btn');
            const selectedCrop = document.getElementById('crop-type-select').value;

            overlay.classList.remove('hidden');
            analyzeBtn.disabled = true;

            try {
                const base64Data = selectedFileBase64.split(',')[1];
                const cropHint = selectedCrop === 'auto'
                    ? 'Tự nhận diện chính xác loại cây trồng trong ảnh.'
                    : `Người dùng gợi ý đây là cây: ${selectedCrop}.`;

                const prompt = `Bạn là Kỹ sư Bảo vệ Thực vật hàng đầu tại Việt Nam. Hãy quan sát thật kỹ hình ảnh này (${cropHint}).
Nếu ảnh KHÔNG phải cây trồng/lá cây/nông sản, hãy ghi rõ trong trường "name" là "Hình ảnh không phải cây trồng" và hướng dẫn chụp lại.
Chỉ trả về DUY NHẤT một chuỗi JSON thuần túy (không giải thích thêm, không bọc markdown) theo đúng mẫu sau:
{
  "crop": "Tên loại cây trồng",
  "name": "Tên bệnh hại hoặc sâu hại cụ thể (hoặc 'Cây khỏe mạnh bình thường' nếu không có bệnh)",
  "confidence": "Tỷ lệ phần trăm tin cậy, ví dụ 95.5%",
  "severity": "Mức độ nguy hại (Thấp / Trung bình / Cao / Rất cao)",
  "symptoms": "Mô tả chi tiết triệu chứng quan sát được trên ảnh",
  "cause": "Nguyên nhân gây bệnh và điều kiện thời tiết phát sinh",
  "bioSteps": ["Biện pháp canh tác/sinh học 1", "Biện pháp canh tác/sinh học 2", "Biện pháp canh tác/sinh học 3"],
  "chemSteps": "Tên hoạt chất thuốc bảo vệ thực vật đặc trị khuyến cáo theo nguyên tắc 4 đúng",
  "extraNote": "Lời khuyên thực tế ngắn gọn giúp nông dân phục hồi vườn cây bền vững"
}`;

                const rawResponse = await callGeminiWithFallback([
                    { text: prompt },
                    { inline_data: { mime_type: 'image/jpeg', data: base64Data } }
                ]);

                // Trích xuất khối JSON an toàn từ câu trả lời của AI
                const jsonMatch = rawResponse.match(/\{[\s\S]*\}/);
                if (!jsonMatch) {
                    throw new Error('AI trả về định dạng chưa chuẩn JSON. Vui lòng bấm Phân Tích lại.');
                }
                const parsed = JSON.parse(jsonMatch[0]);

                displayDiagnosisResult(parsed, parsed.extraNote || '');
                showToast('Gemini AI đã phân tích xong hình ảnh bệnh cây!', 'success');
            } catch (err) {
                console.error('Lỗi AI Diagnosis:', err);
                showToast(`Lỗi quét bệnh AI: ${err.message}`, 'error');
            } finally {
                overlay.classList.add('hidden');
                analyzeBtn.disabled = false;
            }
        }

        function copyDiagnosisReport() {
            if (!currentDiagnosisReport) return;
            const textarea = document.createElement('textarea');
            textarea.value = currentDiagnosisReport;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            showToast('Đã sao chép phác đồ điều trị vào bộ nhớ tạm!', 'success');
        }

        // --- 4. ĐỊNH DẠNG THỨ - NGÀY - THÁNG & THỜI TIẾT THỰC TẾ ---
        let lastRenderedDateKey = '';

        function formatVietnameseFullDate(dateObj) {
            const days = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
            const dayName = days[dateObj.getDay()];
            const dd = String(dateObj.getDate()).padStart(2, '0');
            const mm = String(dateObj.getMonth() + 1).padStart(2, '0');
            const yyyy = dateObj.getFullYear();
            return `${dayName}, ngày ${dd}/${mm}/${yyyy}`;
        }

        function updateLiveClockAndDate() {
            const now = new Date();
            const hh = String(now.getHours()).padStart(2, '0');
            const min = String(now.getMinutes()).padStart(2, '0');
            const ss = String(now.getSeconds()).padStart(2, '0');
            const timeStr = `${hh}:${min}:${ss}`;
            const fullDateText = formatVietnameseFullDate(now);

            const heroDateEl = document.getElementById('hero-current-date');
            const weatherDateEl = document.getElementById('weather-today-full-date');
            const heroClockEl = document.getElementById('hero-live-clock');
            const weatherClockEl = document.getElementById('weather-live-clock');

            if (heroDateEl) heroDateEl.textContent = fullDateText;
            if (weatherDateEl) weatherDateEl.innerHTML = `<i class="fa-regular fa-calendar mr-1.5"></i> ${fullDateText}`;
            if (heroClockEl) heroClockEl.innerHTML = `<i class="fa-regular fa-clock mr-1.5 text-amber-300"></i> ${timeStr} (Giờ địa phương)`;
            if (weatherClockEl) weatherClockEl.innerHTML = `<i class="fa-regular fa-clock mr-1.5 text-amber-300"></i> Thời gian thực: <strong class="text-white ml-1">${timeStr}</strong>`;

            // Tự động làm mới danh sách dự báo 5 ngày nếu bước sang ngày mới (00:00:00)
            const currentDateKey = `${now.getFullYear()}-${now.getMonth()}-${now.getDate()}`;
            if (lastRenderedDateKey && lastRenderedDateKey !== currentDateKey) {
                lastRenderedDateKey = currentDateKey;
                fetchLiveWeather(false);
            }
            lastRenderedDateKey = currentDateKey;
        }

        function formatShortDayLabel(dateStr, offsetIndex) {
            // dateStr dạng YYYY-MM-DD
            const parts = dateStr.split('-');
            const d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
            const days = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
            const dayName = days[d.getDay()];
            const dd = String(d.getDate()).padStart(2, '0');
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            if (offsetIndex === 1) return `Ngày mai (${dayName}, ${dd}/${mm})`;
            return `${dayName}, ngày ${dd}/${mm}`;
        }

        function renderFallbackForecastWithRealDates() {
            const now = new Date();
            const heroDateEl = document.getElementById('hero-current-date');
            const weatherDateEl = document.getElementById('weather-today-full-date');
            const fullDateText = formatVietnameseFullDate(now);

            if (heroDateEl) heroDateEl.textContent = fullDateText;
            if (weatherDateEl) weatherDateEl.innerHTML = `<i class="fa-regular fa-calendar mr-1.5"></i> ${fullDateText}`;

            const listEl = document.getElementById('weather-forecast-list');
            if (!listEl) return;

            const fallbackSamples = [
                { max: 31, min: 23, code: 0, desc: 'Trời quang, nắng ấm' },
                { max: 30, min: 22, code: 2, desc: 'Có mây, nắng nhẹ' },
                { max: 28, min: 21, code: 61, desc: 'Mưa rào nhẹ rải rác' },
                { max: 29, min: 22, code: 2, desc: 'Có mây, gió nhẹ' },
                { max: 31, min: 23, code: 1, desc: 'Nắng ráo thuận lợi' }
            ];

            let html = '';
            for (let i = 1; i <= 5; i++) {
                const future = new Date(now);
                future.setDate(now.getDate() + i);
                const iso = `${future.getFullYear()}-${String(future.getMonth() + 1).padStart(2, '0')}-${String(future.getDate()).padStart(2, '0')}`;
                const item = fallbackSamples[i - 1];
                html += `
                    <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-gray-100">
                        <div class="flex items-center space-x-3">
                            ${getWeatherIcon(item.code)}
                            <div>
                                <div class="text-sm font-bold text-gray-900">${formatShortDayLabel(iso, i)}</div>
                                <div class="text-xs text-gray-500">${item.desc}</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-sm font-bold text-gray-900">${item.max}°C</span>
                            <div class="text-xs text-gray-500">${item.min}°C</div>
                        </div>
                    </div>
                `;
            }
            listEl.innerHTML = html;
        }

        async function fetchLiveWeather(manual = false) {
            const icon = document.getElementById('weather-refresh-icon');
            if (icon && manual) icon.classList.add('fa-spin');

            // Hiển thị ngay Thứ - Ngày - Tháng chuẩn xác trước khi gọi API
            renderFallbackForecastWithRealDates();

            try {
                // Tọa độ Thăng Bình, Đà Nẵng
                const url = 'https://api.open-meteo.com/v1/forecast?latitude=15.74&longitude=108.35&current=temperature_2m,relative_humidity_2m,precipitation_probability,weather_code,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=Asia%2FBangkok';
                const res = await fetch(url);
                if (!res.ok) throw new Error('Không thể tải dữ liệu khí tượng');
                const data = await res.json();

                if (data.current) {
                    const temp = Math.round(data.current.temperature_2m);
                    const hum = data.current.relative_humidity_2m;
                    const wind = Math.round(data.current.wind_speed_10m);
                    const rain = data.current.precipitation_probability ?? 15;
                    const cond = getWeatherDesc(data.current.weather_code);

                    const heroTemp = document.getElementById('hero-weather-temp');
                    const heroDesc = document.getElementById('hero-weather-desc');
                    if (heroTemp) heroTemp.textContent = `${temp}°C`;
                    if (heroDesc) heroDesc.textContent = `${cond} • Độ ẩm ${hum}%`;

                    const wTemp = document.getElementById('weather-temp');
                    const wCond = document.getElementById('weather-condition-text');
                    const wHum = document.getElementById('weather-humidity');
                    const wWind = document.getElementById('weather-wind');
                    const wRain = document.getElementById('weather-rain');
                    const wAdvice = document.getElementById('weather-advice');
                    const wBadge = document.getElementById('weather-badge-time');

                    if (wTemp) wTemp.textContent = `${temp}°C`;
                    if (wCond) wCond.textContent = cond;
                    if (wHum) wHum.textContent = `${hum}%`;
                    if (wWind) wWind.textContent = `${wind} km/h`;
                    if (wRain) wRain.textContent = `${rain}%`;
                    if (wBadge) {
                        const nowSync = new Date();
                        const syncTime = `${String(nowSync.getHours()).padStart(2, '0')}:${String(nowSync.getMinutes()).padStart(2, '0')}`;
                        wBadge.textContent = `Cập nhật ${syncTime}`;
                    }
                    if (wAdvice) {
                        if (rain > 60) {
                            wAdvice.textContent = `Xác suất mưa cao (${rain}%). Bà con tạm hoãn phun thuốc BVTV, khơi thông rãnh thoát nước ruộng lúa và vườn hồ tiêu để tránh ngập úng cục bộ.`;
                        } else if (hum >= 80) {
                            wAdvice.textContent = `Độ ẩm không khí cao (${hum}%) thuận lợi cho nấm đạo ôn lá lúa và sương mai phát triển. Bà con nên thăm đồng kiểm tra và hạn chế bón thừa đạm.`;
                        } else {
                            wAdvice.textContent = `Thời tiết thuận lợi (${temp}°C, độ ẩm ${hum}%). Bà con có thể tiến hành bón phân thúc, làm cỏ sục bùn hoặc phun chế phẩm sinh học phòng trừ sâu bệnh.`;
                        }
                    }
                }

                if (data.daily && data.daily.time) {
                    const listEl = document.getElementById('weather-forecast-list');
                    if (listEl) {
                        let html = '';
                        for (let i = 1; i <= 5; i++) {
                            if (!data.daily.time[i]) break;
                            const dateStr = data.daily.time[i];
                            const maxT = Math.round(data.daily.temperature_2m_max[i]);
                            const minT = Math.round(data.daily.temperature_2m_min[i]);
                            const code = data.daily.weather_code[i];
                            const rainProb = data.daily.precipitation_probability_max?.[i] ?? 10;
                            const desc = getWeatherDesc(code);
                            const iconHtml = getWeatherIcon(code);
                            html += `
                                <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-gray-100 hover:border-blue-200 transition-colors">
                                    <div class="flex items-center space-x-3">
                                        ${iconHtml}
                                        <div>
                                            <div class="text-sm font-bold text-gray-900">${formatShortDayLabel(dateStr, i)}</div>
                                            <div class="text-xs text-gray-500">${desc} • Mưa ${rainProb}%</div>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-sm font-extrabold text-gray-900">${maxT}°C</span>
                                        <div class="text-xs text-gray-500">${minT}°C</div>
                                    </div>
                                </div>
                            `;
                        }
                        if (html) listEl.innerHTML = html;
                    }
                }

                if (manual) showToast('Đã cập nhật dữ liệu thời tiết & thứ ngày mới nhất!', 'success');
            } catch (err) {
                if (manual) showToast('Đang hiển thị lịch thời tiết theo ngày hiện tại.', 'info');
            } finally {
                if (icon && manual) {
                    setTimeout(() => icon.classList.remove('fa-spin'), 400);
                }
            }
        }

        function getWeatherDesc(code) {
            if (code === 0) return 'Trời quang, nắng đẹp';
            if (code <= 3) return 'Có mây, nắng nhẹ';
            if (code <= 48) return 'Sương mù nhẹ buổi sáng';
            if (code <= 67) return 'Có mưa rào nhẹ';
            if (code <= 82) return 'Mưa rào rải rác';
            return 'Có dông vài nơi';
        }

        function getWeatherIcon(code) {
            if (code === 0) return '<div class="w-10 h-10 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center shrink-0"><i class="fa-solid fa-sun"></i></div>';
            if (code <= 3) return '<div class="w-10 h-10 bg-teal-100 text-teal-600 rounded-xl flex items-center justify-center shrink-0"><i class="fa-solid fa-cloud-sun"></i></div>';
            return '<div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center shrink-0"><i class="fa-solid fa-cloud-rain"></i></div>';
        }

        // --- 5. QUẢN LÝ LỊCH CÔNG TÁC ---
        function filterTasks(category, btnEl) {
            document.querySelectorAll('.task-filter').forEach(btn => {
                btn.classList.remove('bg-emerald-600', 'text-white');
                btn.classList.add('bg-gray-100', 'text-gray-600');
            });
            if (btnEl) {
                btnEl.classList.add('bg-emerald-600', 'text-white');
                btnEl.classList.remove('bg-gray-100', 'text-gray-600');
            }

            document.querySelectorAll('.task-item').forEach(item => {
                if (category === 'all' || item.dataset.category === category) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
        }

        function toggleTaskComplete(checkbox) {
            const title = checkbox.parentElement.querySelector('h4');
            if (checkbox.checked) {
                title.classList.add('line-through', 'opacity-60');
            } else {
                title.classList.remove('line-through', 'opacity-60');
            }
        }

        function openAddTaskModal() {
            document.getElementById('task-modal').classList.remove('hidden');
        }

        function closeAddTaskModal() {
            document.getElementById('task-modal').classList.add('hidden');
        }

        function handleAddTask(e) {
            e.preventDefault();
            const title = document.getElementById('new-task-title').value.trim();
            const cat = document.getElementById('new-task-cat').value;
            const desc = document.getElementById('new-task-desc').value.trim() || 'Ghi chú công việc canh tác do nhà nông tự thêm.';

            const catLabels = {
                lua: { label: 'Cây Lúa', bg: 'bg-emerald-100 text-emerald-800' },
                hoamau: { label: 'Đậu phộng & Hoa màu', bg: 'bg-amber-100 text-amber-800' },
                cayanqua: { label: 'Hồ tiêu & Cây ăn quả', bg: 'bg-teal-100 text-teal-800' }
            };
            const meta = catLabels[cat] || catLabels.lua;

            const list = document.getElementById('task-list');
            const newItem = document.createElement('div');
            newItem.className = 'task-item p-4 rounded-2xl border border-gray-200 bg-white flex items-start justify-between gap-4';
            newItem.dataset.category = cat;
            newItem.innerHTML = `
                <div class="flex items-start space-x-3.5">
                    <input type="checkbox" onchange="toggleTaskComplete(this)" class="mt-1 w-5 h-5 rounded text-emerald-600 focus:ring-emerald-500 cursor-pointer">
                    <div>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold ${meta.bg}">${meta.label}</span>
                        <h4 class="text-sm font-bold text-gray-900 mt-1">${title}</h4>
                        <p class="text-xs text-gray-600 mt-1">${desc}</p>
                    </div>
                </div>
                <span class="text-xs font-bold text-emerald-700 whitespace-nowrap">Mới thêm</span>
            `;
            list.prepend(newItem);

            e.target.reset();
            closeAddTaskModal();
            showToast('Đã thêm công việc mới vào lịch canh tác!', 'success');
        }

        // --- 6. HỎI ĐÁP CÙNG KỸ SƯ NÔNG NGHIỆP AI ---
        async function handlePostQuestion(e) {
            e.preventDefault();
            const author = document.getElementById('q-author').value.trim();
            const category = document.getElementById('q-category').value;
            const content = document.getElementById('q-content').value.trim();

            if (!getActiveApiKey()) {
                showToast('Lỗi: Chưa cấu hình GEMINI_API_KEY trong mã nguồn!', 'error');
                return;
            }

            const feed = document.getElementById('community-feed');
            const initial = author.charAt(0).toUpperCase() || 'N';
            const postId = 'post-' + Date.now();
            const nowLabel = formatVietnameseFullDate(new Date());

            const card = document.createElement('div');
            card.id = postId;
            card.className = 'bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-purple-200 space-y-4';
            card.innerHTML = `
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-purple-100 text-purple-700 rounded-full flex items-center justify-center font-bold">${initial}</div>
                        <div>
                            <h4 class="text-sm font-bold text-gray-900">${author}</h4>
                            <p class="text-[11px] text-gray-500">Nông dân • ${category} • ${nowLabel}</p>
                        </div>
                    </div>
                    <span class="ai-status-badge px-3 py-1 bg-amber-50 text-amber-700 text-xs font-bold rounded-full">
                        <i class="fa-solid fa-spinner fa-spin mr-1"></i> Kỹ sư AI đang trả lời...
                    </span>
                </div>
                <p class="text-sm text-gray-700 leading-relaxed">${content}</p>
                <div class="ai-reply-box bg-purple-50/60 rounded-2xl p-4 border border-purple-100 space-y-2">
                    <div class="flex items-center space-x-2 text-xs font-bold text-purple-700">
                        <i class="fa-solid fa-user-doctor"></i>
                        <span>Kỹ sư Nông nghiệp AI phản hồi trực tuyến:</span>
                    </div>
                    <p class="ai-reply-text text-xs text-gray-600 italic leading-relaxed">Đang phân tích câu hỏi và tra cứu quy trình kỹ thuật nông nghiệp...</p>
                </div>
            `;
            feed.prepend(card);
            e.target.reset();

            try {
                const prompt = `Bạn là Kỹ sư Nông nghiệp giàu kinh nghiệm tại Việt Nam. Hãy trả lời rõ ràng, thực tế, dễ hiểu và ưu tiên an toàn sinh học cho câu hỏi sau của nông dân (${author}, chủ đề: ${category}): "${content}"`;
                const reply = await callGeminiWithFallback([
                    { text: prompt }
                ]);

                const badge = card.querySelector('.ai-status-badge');
                const replyText = card.querySelector('.ai-reply-text');
                badge.className = 'ai-status-badge px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-full';
                badge.innerHTML = '<i class="fa-solid fa-circle-check mr-1"></i> Kỹ sư AI đã giải đáp';
                replyText.className = 'ai-reply-text text-xs sm:text-sm text-gray-800 whitespace-pre-line leading-relaxed';
                replyText.textContent = reply;
                showToast('Kỹ sư AI đã giải đáp câu hỏi của bạn!', 'success');
            } catch (err) {
                const badge = card.querySelector('.ai-status-badge');
                const replyText = card.querySelector('.ai-reply-text');
                badge.className = 'ai-status-badge px-3 py-1 bg-rose-50 text-rose-700 text-xs font-bold rounded-full';
                badge.innerHTML = '<i class="fa-solid fa-circle-xmark mr-1"></i> Lỗi kết nối AI';
                replyText.className = 'ai-reply-text text-xs text-rose-600 leading-relaxed';
                replyText.textContent = `Không gọi được Gemini AI: ${err.message}`;
                showToast(`Không gọi được Gemini AI: ${err.message}`, 'error');
            }
        }

        // --- 7. KHỞI TẠO ỨNG DỤNG ---
        window.addEventListener('DOMContentLoaded', () => {
            renderSampleButtons();
            updateLiveClockAndDate();
            setInterval(updateLiveClockAndDate, 1000);
            fetchLiveWeather(false);
            // Tự động đồng bộ lại thời tiết thực tế mỗi 5 phút
            setInterval(() => fetchLiveWeather(false), 300000);
        });
    </script>
</body>
</html>
