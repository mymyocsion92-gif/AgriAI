    <!-- ================= MÃ JAVASCRIPT HOẠT ĐỘNG ================= -->
    <script>
        // =========================================================================
        // CẤU HÌNH MÃ API KEY (ĐÃ TÍCH HỢP SẴN TRONG MÃ NGUỒN)
        const GEMINI_API_KEY = "AQ.Ab8RN6KoXbzOMjVKwKjKbDeNa2_h31xR-mNEJVtYDW6yO4J_CQ";
        // =========================================================================

        function getActiveApiKey() {
            return (GEMINI_API_KEY || '').trim();
        }

        // --- 1. HỆ THỐNG THÔNG BÁO (TOAST) ---
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let bgClass = 'bg-emerald-600 text-white';
            let icon = 'fa-circle-check';
            if (type === 'warning') { bgClass = 'bg-amber-500 text-gray-950'; icon = 'fa-triangle-exclamation'; }
            if (type === 'error') { bgClass = 'bg-rose-600 text-white'; icon = 'fa-circle-xmark'; }
            if (type === 'info') { bgClass = 'bg-blue-600 text-white'; icon = 'fa-circle-info'; }

            toast.className = `${bgClass} px-4 py-3 rounded-2xl shadow-lg flex items-center space-x-3 text-xs sm:text-sm font-semibold pointer-events-auto transform transition-all duration-300 translate-x-full opacity-0`;
            toast.innerHTML = `<i class="fa-solid ${icon} text-base shrink-0"></i><span>${message}</span>`;
            
            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove('translate-x-full', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('translate-x-full', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        // --- 2. ĐIỀU HƯỚNG TAB ---
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            const target = document.getElementById('tab-' + tabId);
            if (target) target.classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-white', 'text-emerald-700', 'shadow-sm');
                btn.classList.add('text-gray-600');
            });
            const activeBtn = document.getElementById('nav-' + tabId);
            if (activeBtn) {
                activeBtn.classList.add('bg-white', 'text-emerald-700', 'shadow-sm');
                activeBtn.classList.remove('text-gray-600');
            }
            if (tabId === 'weather-calendar') {
                fetchLiveWeather(false);
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

